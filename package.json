{
    "name": "rustplusplus",
    "version": "2.0.0-rc.1",
    "description": "A NodeJS Discord Bot that uses the rustplus.js library to utilize the power of the Rust+ Companion App with additional Quality-of-Life features.",
    "main": "index.ts",
    "scripts": {
        "start": "ts-node index.ts",
        "startn": "node --no-deprecation -r ts-node/register index.ts",
        "compile": "tsc",
        "preinstall": "npx npm-force-resolutions",
        "test": "tsc --noEmit -p .",
        "lint": "npx eslint . --ext .ts",
        "gen-env": "ts-node scripts/generate-env.ts",
        "gen-icons": "ts-node scripts/generate-icons.ts",
        "unusedPhrases": "npx ts-node scripts/findUnusedPhrases.ts",
        "find-eslint-comments": "grep -r --exclude-dir=node_modules 'eslint-disable' .",
        "force-update-master": "git fetch origin && git reset --hard origin/master"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/alexemanuelol/rustplusplus.git"
    },
    "author": "Alexemanuelol",
    "license": "SEE LICENSE IN LICENSE",
    "bugs": {
        "url": "https://github.com/alexemanuelol/rustplusplus/issues"
    },
    "homepage": "https://github.com/alexemanuelol/rustplusplus#readme",
    "dependencies": {
        "@discordjs/rest": "^2.6.1",
        "@discordjs/voice": "^0.19.2",
        "@formatjs/intl": "^4.1.10",
        "@liamcottle/push-receiver": "github:Trophy198/push-receiver#412172c3e9b942e0b9569a169e27bce26bfaac0a",
        "@napi-rs/canvas": "^1.0.0",
        "@types/lodash": "^4.17.24",
        "axios": "^1.16.1",
        "colors": "^1.4.0",
        "discord-api-types": "^0.38.47",
        "discord.js": "^14.26.4",
        "dotenv": "^17.4.2",
        "fast-xml-parser": "^5.8.0",
        "ffmpeg-static": "^5.3.0",
        "libsodium-wrappers": "^0.8.4",
        "lodash": "^4.18.1",
        "rustplus-ts": "^0.0.10",
        "translate": "^3.0.1",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "resolutions": {
        "jpeg-js": "0.4.4",
        "protobufjs": "8.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@typescript-eslint/eslint-plugin": "^8.59.3",
        "@typescript-eslint/parser": "^8.59.3",
        "eslint": "^10.3.0",
        "globals": "^17.6.0",
        "typescript-eslint": "^8.59.3"
    }
}