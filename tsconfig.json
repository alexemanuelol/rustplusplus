{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "index.ts",
    "src/**/*",
    "config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "credentials",
    "instances",
    "logs",
    "maps",
    "temp"
  ]
}
